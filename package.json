{
  "name": "dsh-plugin-chatgpt",
  "version": "0.1.17",
  "description": "Sign in with ChatGPT inside DeepSeek Harness, and use your ChatGPT subscription to serve models.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "chatgpt",
    "openai",
    "oauth",
    "subscription",
    "model-provider"
  ],
  "license": "MIT",
  "author": {
    "name": "Kanner",
    "email": "kanner.chen@gmail.com"
  },
  "homepage": "https://github.com/iBobbyTS/dsh-plugin-chatgpt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iBobbyTS/dsh-plugin-chatgpt.git"
  },
  "bugs": {
    "url": "https://github.com/iBobbyTS/dsh-plugin-chatgpt/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./auth": {
      "types": "./lib/types/auth/manager.d.ts",
      "default": "./lib/auth/manager.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "screenshots.json",
    "assets",
    "docs/README.zh.md",
    "docs/cache-replay.md",
    "docs/usage-accounting.md",
    "docs/codex-quota.md",
    "docs/auth-and-models.md",
    "docs/architecture.md",
    "docs/development.md",
    "src"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && tsc -p tsconfig.tests.json",
    "test": "node scripts/check.mjs test",
    "check:i18n": "node scripts/align-readme-i18n.mjs --check",
    "verify:client": "node scripts/verify-client-bundle.mjs",
    "verify:harness": "node scripts/verify-harness.mjs",
    "verify:package": "node scripts/verify-package-contents.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "check:dist": "node scripts/check.mjs dist",
    "check": "node scripts/check.mjs all"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.2"
}
